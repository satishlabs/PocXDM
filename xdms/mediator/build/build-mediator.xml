<project name="Mediator Layer Interface" default="build-all" basedir=".">

    <property file="build-mediator.properties"/>

    <target name="build-all" depends="clean, prepare, compile-dependent, create-jar"/>
    <target name="create-jar.nodep" depends="create-jar"/>

    <target name="clean" description="Remove all generated files.">
        <delete dir="${build.dir}"/>
    </target>

    <target name="compile-dependent" description="Compiling dependent jars">
        <echo>Compiling Common Dependents</echo>
        <echo>Compiling Common Lib</echo>
        <ant antfile="build-common.xml" target="create-jar.nodep"/>
        <echo>Compiling IDGEN Utililty</echo>
        <ant antfile="build-utilities.xml" target="create-idgen-jar.nodep"/>
        <echo>Compiling XMLModifier Utility</echo>
        <ant antfile="build-utilities.xml" target="create-xmlmodifier-jar.nodep"/>
        <echo>Compile Process Invoker</echo>
        <ant antfile="build-utilities.xml" target="create-processinvoker-jar.nodep"/>
        <echo>Compile the spring container</echo>
        <ant antfile="build-utilities.xml" target="create-spring-container-jar"/>
        <echo>Compile LiEvent Handler</echo>
        <ant antfile="build-utilities.xml" target="create-lievent.jar.nodep"/>
        <echo>Compiling Messaging FW</echo>
        <ant antfile="build-messaging.xml" target="create-jar.nodep"/>
        <echo>Compiling Stastistical Manager</echo>
        <ant antfile="build-statisticalmgrfw.xml" target="create-jar.nodep"/>
        <echo>Compiling Server Common Lib</echo>
        <ant antfile="build-server-common.xml" target="create-jar.nodep"/>
        <echo>Compiling Server Pubmgmt Lib</echo>
        <ant antfile="build-pubmgmtlib.xml" target="create-jar.nodep"/>
        <echo>Compiling Server Pubmgmt Lib</echo>
        <ant antfile="build-corpmgmtlib.xml" target="create-jar.nodep"/>
        <echo>Compiling Server activation Lib</echo>
        <ant antfile="build-activation.xml" target="create-jar.nodep"/>
        <echo>Compiling Server SubsProv Lib</echo>
        <ant antfile="build-subsmgmt.xml" target="create-jar.nodep"/>
        <echo>Compiling Server Xcap Notify Mgr</echo>
        <ant antfile="build-xcapnotifymgr.xml" target="create-jar.nodep"/>
        <echo>Compiling Scheduler</echo>
        <ant antfile="build-jobscheduler.xml" target="create-jar.nodep"/>
         <echo>Compile Bulk FW</echo>
        <ant antfile="build-bulkfw.xml" target="create-jar.nodep"/>
        <echo>Compile NNICG Library</echo>
        <ant antfile="build-cgmgmtlib.xml" target="create-jar.nodep"/>
        <echo>Compile NNICA Library</echo>
        <ant antfile="build-camgmtlib.xml" target="create-jar.nodep"/>
        <echo>Compile XDM Interface Library</echo>
        <ant antfile="build-xdmintf.xml" target="create-jar.nodep"/>
        <echo>Compiling Server Mcs Notify Mgr</echo>
        <ant antfile="build-mcsnotifymgr.xml" target="create-jar.nodep"/>
        <echo>Compiling BulkOps Lib</echo>
        <ant antfile="build-bulkops.xml" target="create-jar.nodep"/>
    </target>

    <target name="create-jar" depends="compile" description="Building Mediator jar">
        <echo>Creating Mediator jar</echo>
        <copy todir="${temp.classes}">
            <fileset dir="${mediator-conf.dir}" includes="*.properties,*.xml" />
        </copy>
        <jar jarfile="${build-lib.dir}/${xdms-mediator-jar.name}" basedir="${temp.classes}"/>
        <delete dir="${temp.classes}"/>
    </target>

    <target name="compile" description="Compiling the Mediator jar">
        <echo>Compiling Mediator</echo>
        <mkdir dir="${temp.classes}"/>
        <javac debug="on" srcdir="${mediator-src.dir}" excludes="test/**" destdir="${temp.classes}">
            <classpath refid="proto.path"/>
        </javac>
    </target>

    <target name="prepare" unless="prepared">
        <property name="prepared" value="true"/>
        <echo>Preparing build directories.</echo>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${build-lib.dir}"/>
    </target>

