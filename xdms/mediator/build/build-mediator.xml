        <pathelement location="${build-lib.dir}/${xdms-nnicgmgmt-jar.name}"/>
        <pathelement location="${build-lib.dir}/${xdms-nnicamgmt-jar.name}"/>
        <pathelement location="${build-lib.dir}/${spring-container-jar.name}"/>
