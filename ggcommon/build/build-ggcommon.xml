<project name="Common-build" default="build-all" basedir=".">
    <property file="build-ggcommon.properties"/>

    <!-- Cleaning entire build directory -->
    <target name="clean" description="Remove all generated files.">
        <delete dir="${build.dir}"/>
    </target>
    <target name="build-all" depends="clean, prepare, create-jar"/>

    <target name="create-jar.nodep" depends="compile"/>

    <target name="create-jar" depends="compile"/>

    <target name="compile" depends=" license-zip, fetch-license-parser, build-dependent" description="Building common DTO">
        <mkdir dir="${temp.classes}"/>
        <javac debug="on" srcdir="${ggcommon-src.dir}" excludes="**/asn1/*,**/ems/*" destdir="${temp.classes}">
            <classpath refid="proto.path"/>
        </javac>

        <jar jarfile="${build-lib.dir}/${pocxdm-ggcommon-jar.name}">
            <fileset dir="${temp.classes}"/>
        </jar>
        <delete dir="${temp.classes}"/>
    </target>

    <path id="proto.path">
        <pathelement location="${build-lib.dir}/${kodiakdbmgr.jar.name}"/>
        <pathelement location="${build-lib.dir}/${logger-jar.name}"/>
        <pathelement location="${build-lib.dir}/${license-jar.name}"/>
        <pathelement location="${build-lib.dir}/${pocxdm-common-jar.name}"/>

    	<pathelement location="${logger-lib.dir}/log4j-api.jar"/>
    	<pathelement location="${logger-lib.dir}/log4j-core.jar"/>
        <pathelement path="${pocxdm.dir}/lib/annotations.jar"/>
        <pathelement path="${pocxdm.dir}/lib/cache-api.jar"/>
        <pathelement path="${pocxdm.dir}/lib/gridgain-core.jar"/>
        <pathelement path="${pocxdm.dir}/lib/h2.jar"/>
        <pathelement path="${pocxdm.dir}/lib/ignite-core.jar"/>
        <pathelement path="${pocxdm.dir}/lib/ignite-indexing.jar"/>

    </path>

    <target name="license-zip" description="Fetching license zip file">
        <copy todir="${build.dir}" file="${license-zip.home.dir}/${license-zip.name}"/>
    </target>

    <target name="fetch-license-parser" description="Fetching License Parser files">
        <unzip src="${zip.dir}/${license-zip.name}" dest="${build-unzip.dir}"/>
        <copy file="${build-unzip.dir}/lib/${license-jar.name}" todir="${build-lib.dir}"/>
    </target>

    <target name="prepare" depends="set-filter" unless="prepared">
        <property name="prepared" value="true"/>
        <echo>Preparing build directories.</echo>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${build-lib.dir}"/>
    </target>

    <target name="set-filter" description="Setting the filter file">
        <filter filtersfile="build-common.properties"/>
    </target>

     <!-- Build the dependant libraries-->
     <target name="build-dependent" depends="fetch-dependant-build-scripts" description="Compiling POCXDM dependant lib">
         	<echo>-> Compile Logger Library</echo>
                 <ant antfile="build-logger.xml" target="create-jar.nodep"/>
            <echo>-> Compileed</echo>
            <echo>-> Compile DB Manager Library</echo>
                 <ant antfile="build-dbmgr.xml" target="create-jar.nodep"/>
            <echo>-> Compiled</echo>
         <echo>-> Compile common Library</echo>
         <ant antfile="build-common.xml" target="create-jar.nodep"/>
         <echo>-> Compiled</echo>

    </target>

    <!-- Fetching the dependant build scripts-->
    <target name="fetch-dependant-build-scripts">
         <echo>Fetching all dependent common build scripts</echo>
         <copy todir="." overwrite="true" filtering="true">
            <fileset dir="${pocxdm-logger-build.dir}" includes="*.*"/>
         </copy>
         <copy todir="." overwrite="true" filtering="true">
           <fileset dir="${pocxdm-dbmgr-build.dir}" includes="*.*"/>
         </copy>
   </target>
</project>